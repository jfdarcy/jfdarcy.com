---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsBar from '../components/StatsBar.astro';
import SocialProof from '../components/SocialProof.astro';
import HomeCta from '../components/HomeCta.astro';
import { site } from '../data/site';
import { portfolioItems } from '../data/site';

const featuredWork = portfolioItems.filter((item) => !item.inProgress).slice(0, 3);
---

<BaseLayout
  title={site.name}
  description="Human factors engineer and cognitive scientist, currently Design Engineering Senior Advisor at Peraton supporting FAA air traffic modernization. 25+ years in safety-critical systems, enterprise SaaS, and product building."
  heroTitle="Building better products by combining cognitive science, rigorous research, and AI."
  wide
>
  <Fragment slot="after-hero">
    <StatsBar />
  </Fragment>

  <div class="intro-block">
    <h2>Hi, I'm JF!</h2>
    <p>
      I'm a cognitive scientist and human factors engineer with over 25 years of experience optimizing complex
      human-machine systems where safety, cognitive workload, and decision-making are critical. Currently, I serve as a
      Design Engineering Senior Advisor at Peraton, supporting the FAA's Alaska Automation Capability (AAC) under the
      Brand New Air Traffic Control System (BNATCS) program, applying human factors engineering and user-centered
      design to modernize Alaska's 17 Flight Service Stations.
    </p>
    <p>
      My career spans air traffic management, defense, nuclear power, and enterprise SaaS UX research. Outside of work,
      I build AI-enabled research tools and side projects that accelerate research and turn insights into action.
      Whatever the domain, my focus is the same: ensuring technology adapts to how humans think, perceive, and perform
      in demanding operational environments.
    </p>
    <HomeCta />
  </div>

  <SocialProof part="products" />

  <section class="featured-work">
    <h2 class="section-heading">Selected UX research work</h2>
    <div class="featured-work__grid">
      {
        featuredWork.map((item) => (
          <a class="featured-work__card" href={item.href}>
            <div class="featured-work__image">
              <img src={item.image} alt={item.imageAlt} loading="lazy" width="600" height="450" />
            </div>
            <div class="featured-work__text">
              <p class="featured-work__method">{item.subtitle}</p>
              <p class="featured-work__title">{item.title}</p>
            </div>
          </a>
        ))
      }
    </div>
    <p class="featured-work__more"><a href="/portfolio">View all work &rarr;</a></p>
  </section>

  <SocialProof part="experience" />
</BaseLayout>
